# Server Configuration
PORT=5001
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# AI Provider Configuration (Groq or xAI)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional Groq Model (default: llama-3.3-70b-versatile or mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Alternatively, configure xAI / Grok
# XAI_API_KEY=xai_your_xai_key_here
# XAI_MODEL=grok-2-latest

# Database
DATABASE_PATH=../database/marketing_consultant.sqlite
